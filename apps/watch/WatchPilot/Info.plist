<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Watch Pilot</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>WKApplication</key>
	<true/>
	<key>WKWatchOnly</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>physical-therapy</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>PROGRESS_POLL</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>O Watch Pilot grava o teu comando de voz e envia-o ao teu Mac Mini, que o transcreve localmente.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>WPHubBaseURL</key>
	<string>https://watch.kluser.me</string>
	<key>WPHubLocalURL</key>
	<string>http://mac-mini.local:8765</string>
	<key>WPHubSimulatorURL</key>
	<string>http://localhost:8765</string>
	<key>WPPollIntervalSeconds</key>
	<integer>3</integer>
	<key>WPExtendedSessionType</key>
	<string>physical-therapy</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
